# Скопируйте в .env и заполните
SECRET_KEY=сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
SITE_TITLE=Заметки
SITE_TAGLINE=личный блог об IT
SITE_URL=https://example.ru
CONTACT_EMAIL=
# Номер счётчика Яндекс.Метрики; пусто — счётчика нет
YANDEX_METRIKA_ID=
# 0 только для локального запуска по http
SESSION_COOKIE_SECURE=1

# Вход автора: заполняется командами
#   flask --app wsgi set-password
#   flask --app wsgi setup-2fa
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_BACKUP_CODE_HASHES=

# Картинки в статьях
MAX_UPLOAD_MB=10
